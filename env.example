# LANStreamer environment template.
# Copy to .env and fill in real values. NEVER commit your real .env.

# --- Admin credentials (CHANGE THESE before any real event) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
JWT_SECRET=generate-a-long-random-string
SESSION_SECRET=generate-another-long-random-string

# --- Server ---
PORT=3001
HOST=0.0.0.0

# --- External tools (optional; auto-detected when omitted) ---
# ICECAST_EXE_PATH=C:\path\to\icecast.exe
# ICECAST_CONFIG_PATH=C:\path\to\icecast.xml

# --- Telemetry (optional; disabled when POSTHOG_KEY is not configured) ---
# Get the public project token and ingestion host from your PostHog project settings.
# Operators can turn telemetry off in the app's tray menu or Admin account card.
POSTHOG_KEY=phc_your_public_project_token
POSTHOG_HOST=https://your-posthog-ingestion-host
