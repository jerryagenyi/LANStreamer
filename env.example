# LANStreamer environment template.
# Copy to .env and fill in real values. NEVER commit your real .env.

# --- Admin credentials (CHANGE THESE before any real event) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
JWT_SECRET=generate-a-long-random-string
SESSION_SECRET=generate-another-long-random-string

# --- Server ---
PORT=3001
HOST=0.0.0.0

# --- External tools (optional; auto-detected when omitted) ---
# ICECAST_EXE_PATH=C:\path\to\icecast.exe
# ICECAST_CONFIG_PATH=C:\path\to\icecast.xml

# --- Telemetry (optional; off unless users consent) ---
# Get the key from your PostHog project settings. Nothing is sent without
# per-install consent (first-run prompt; toggle in the tray menu).
# POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
# POSTHOG_HOST=https://eu.i.posthog.com
